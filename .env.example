# =============================================================================
# fastapi-saas-starter — environment template
# Copy to `.env` for local development; never commit a real `.env` file.
# =============================================================================

# --- Core ---
APP_NAME=fastapi-saas-starter
API_V1_PREFIX=/api/v1
# Set DEBUG=true locally; production MUST be false (fails fast on missing
# SECRET_KEY — see app/config.py for the fail-fast guard).
DEBUG=false

# --- Security ---
# Generate a real key with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-a-32-byte-url-safe-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (asyncpg) ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list, or a JSON array. Localhost defaults below.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limit (slowapi) ---
RATE_LIMIT_DEFAULT=60/minute
